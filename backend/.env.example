# Salin file ini jadi .env lalu isi nilainya. Jangan commit .env
SELA_API_KEY=ganti_dengan_string_acak_panjang
SELA_DB_PATH=./data/sela.db
SELA_EXPECTED_DEVICES=sela-node-a,sela-node-b
SELA_STALE_AFTER_S=15
SELA_INITIAL_BALANCE_WH=5

# Pelacakan cut-off per node (perintah OFF saat saldo nol)
SELA_CMD_TIMEOUT_S=10
SELA_CMD_RETRIES=2
SELA_CMD_TICK_S=1

# Sinric Pro. SINRIC_API_KEY kosong = backend tidak memanggil REST Sinric (hanya lewat balasan telemetri)
SINRIC_APP_KEY=
SINRIC_APP_SECRET=
SINRIC_API_KEY=
SINRIC_DEVICE_A_ID=
SINRIC_DEVICE_B_ID=
# Uji lokal dengan sinric/mock_sinric.py: SINRIC_API_BASE=http://localhost:8790
# SINRIC_API_BASE=https://api.sinric.pro